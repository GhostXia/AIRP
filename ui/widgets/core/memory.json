{
  "type": "core.memory",
  "version": "0.2.0",
  "title": "未分类 resident memory",
  "description": "Editable session-scoped resident memory text. Its content is unclassified and is not presented as verified fact or advice.",
  "stateSchema": {
    "type": "object",
    "required": ["content", "content_hash", "char_count", "capacity_chars", "source"],
    "properties": {
      "content": { "type": "string" },
      "content_hash": { "type": "string" },
      "char_count": { "type": "integer", "minimum": 0 },
      "capacity_chars": { "type": "integer", "minimum": 0 },
      "source": {
        "type": "object",
        "required": ["kind", "scope", "character_id", "session_id"],
        "properties": {
          "kind": { "const": "resident_memory" },
          "scope": { "const": "session" },
          "character_id": { "type": "string" },
          "session_id": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "additionalProperties": false
  },
  "intents": ["memory.replace"],
  "capabilities": ["read:memory", "write:memory"],
  "entry": { "kind": "builtin" },
  "author": "AIRP",
  "license": "MIT OR Apache-2.0"
}
