{
  "type": "core.chat",
  "version": "0.1.0",
  "title": "对话",
  "description": "Roleplay conversation view: streamed messages with virtualized scrollback.",
  "propsSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "title": { "type": "string" },
      "placeholder": { "type": "string" }
    }
  },
  "stateSchema": {
    "type": "object",
    "properties": {
      "messages": {
        "type": "array",
        "description": "Windowed message slice; full history lives in the Gateway.",
        "items": {
          "type": "object",
          "required": ["role", "content"],
          "properties": {
            "role": { "type": "string", "enum": ["user", "assistant", "system"] },
            "content": { "type": "string" }
          }
        }
      },
      "message_ids": { "type": "array", "items": { "type": "string" } },
      "has_more": { "type": "boolean" },
      "oldest_id": { "type": ["string", "null"] },
      "context": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "character_id": { "type": "string" },
          "session_id": { "type": "string" },
          "persona_id": { "type": ["string", "null"] },
          "persona_source": {
            "type": ["string", "null"],
            "enum": ["session_binding", "character_binding", "default", null]
          },
          "scene_id": { "type": ["string", "null"] },
          "worldbook_source_ids": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  },
  "intents": ["chat.send", "chat.regen", "chat.continue", "chat.stop", "chat.swipe", "chat.loadMore"],
  "capabilities": ["read:state"],
  "entry": { "kind": "builtin" },
  "author": "AIRP",
  "license": "MIT OR Apache-2.0"
}
